# Copy to .env and fill in. NEVER commit .env — it is gitignored.
# Your private key stays on YOUR machine only. It is never shown to or handled
# by anyone else; Foundry reads it locally at deploy time.

# --- RPC endpoints (free tiers work fine for testnet) ---
# Base Sepolia public RPC (no key needed):
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Base mainnet (for later):
BASE_RPC_URL=https://mainnet.base.org

# --- Contract verification on Basescan (optional for testnet) ---
# Get a free key at https://basescan.org/myapikey
BASESCAN_API_KEY=

# --- Deploy parameters (optional; sane defaults baked into Deploy.s.sol) ---
# 0.0005 ether = 500000000000000 wei
SCAN_PRICE_WEI=500000000000000
# 0.005 ether = 5000000000000000 wei
PASS_PRICE_WEI=5000000000000000
# 30 days in seconds
PASS_DURATION_SECONDS=2592000

# --- Deployer key: DO NOT put your key here in plaintext for real funds. ---
# Preferred: use an encrypted keystore instead (see README):
#   cast wallet import deployer --interactive
# If you must use a raw testnet key for convenience, you can set:
# PRIVATE_KEY=0x...
